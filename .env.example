# Public origin of the site, no trailing slash, e.g. https://teemeup.ai
# While empty: no canonical URLs, no sitemap entries. Never guess a domain.
NEXT_PUBLIC_SITE_URL=
# Set to 1 to show the publication-gate banner on each page (development only).
NEXT_PUBLIC_SHOW_GATE=
# 1 = noindex everywhere (staging/previews). Without NEXT_PUBLIC_SITE_URL the site is noindex anyway.
NEXT_PUBLIC_NOINDEX=
